'use client';
import { useState } from "react";
import { useRouter } from "next/navigation";
import Link from "next/link";

export default function AuthPage() {
  const [tab, setTab] = useState<'signin' | 'signup'>('signin');
  const [error, setError] = useState('');
  const router = useRouter();

  const handleSubmit = (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    const password = (form.elements.namedItem('password') as HTMLInputElement).value;

    if (email === 'demo@luminar.ai' && password === '1234') {
      localStorage.setItem('luminar_auth', 'true'); // fake session
      router.push('/dashboard');
    } else {
      setError('Use demo@luminar.ai / 1234 for demo');
    }
  };

  return (
    <main className="min-h-screen bg-black text-white flex items-center justify-center px-6">
      <div className="w-full max-w-sm">
        
        <Link href="/" className="block text-center mb-8 text-white/50 text-sm hover:text-[#FFB800]">
          ← Back to Luminar
        </Link>

        <div className="bg-[#0A0A0F] rounded-3xl border-white/10 p-8 shadow-[0_0_60px_rgba(255,215,0,.1)]">
          
          <div className="flex bg-black/50 rounded-2xl p-1 mb-6">
            <button 
              onClick={() => setTab('signin')}
              className={`w-1/2 py-2 rounded-xl font-bold text-sm transition ${tab === 'signin'? 'bg-[#FFB800] text-black' : 'text-white/70'}`}
            >
              Sign In
            </button>
            <button 
              onClick={() => setTab('signup')}
              className={`w-1/2 py-2 rounded-xl font-bold text-sm transition ${tab === 'signup'? 'bg-[#00D9FF] text-black' : 'text-white/70'}`}
            >
              Sign Up
            </button>
          </div>

          <form className="space-y-4" onSubmit={handleSubmit}>
            <input 
              name="email"
              type="email" 
              placeholder="Email" 
              defaultValue="demo@luminar.ai"
              className="w-full bg-black/50 border-white/10 rounded-xl px-4 py-3 text-sm outline-none focus:border-[#FFB800]"
            />
            <input 
              name="password"
              type="password" 
              placeholder="Password" 
              defaultValue="1234"
              className="w-full bg-black/50 border-white/10 rounded-xl px-4 py-3 text-sm outline-none focus:border-[#FFB800]"
            />
            
            {error && <p className="text-red-400 text-xs text-center">{error}</p>}

            <button 
              type="submit"
              className="w-full bg-gradient-to-r from-[#FFB800] to-[#00D9FF] text-black font-bold py-3 rounded-xl hover:scale-[1.02] transition"
            >
              {tab === 'signin'? 'Enter Luminar' : 'Create Account'}
            </button>
          </form>

          <p className="text-center text-white/40 text-xs mt-6">
            Demo: demo@luminar.ai / 1234
          </p>

        </div>
      </div>
    </main>
  );
}

